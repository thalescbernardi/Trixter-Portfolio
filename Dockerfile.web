# Interface Streamlit. Segredos entram só na execução, nunca nesta imagem.
FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL -o /tmp/packages-microsoft-prod.deb https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ["Gerenciador de Gastos V2.py", "iniciar_web.py", "./"]
COPY trixter ./trixter
COPY assets ./assets
COPY .streamlit/config.toml .streamlit/config.toml

RUN useradd --create-home --uid 10001 trixter \
    && chown -R trixter:trixter /app
USER trixter

EXPOSE 8501
ENV WEBSITES_PORT=8501
ENTRYPOINT ["python", "iniciar_web.py"]
